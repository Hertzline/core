<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hertzline.D1.Avalonia</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Avalonia 12.1.6 analyzers need Roslyn 4.14+; .NET 8 SDK ships 4.11. Suppress CS9057. -->
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
</Project>

